{
  "model": "opencode/deepseek-v4.1-flash-free",
  "providers": {
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "body": {
            "temperature": 0.1,
            "reasoning_effort": "none"
          }
        }
      }
    }
  },
  "watcher": {
    "ignore": ["logs/**"]
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": 20000
  },
  "permissions": [
    // Auto mode: allow everything. Anything not listed defaults to `ask`
    // (see docs), so this single rule removes prompting for all tools.
    { "action": "*", "resource": "*", "effect": "allow" },
    // Never read .env files. The last matching rule wins, so this must stay
    // after the blanket allow above or it would have no effect.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    // Ask before loading the example-writing skill, since invoking it writes
    // new files into examples/ and tests/. Last match wins, so this must stay
    // after the blanket allow above.
    { "action": "skill", "resource": "create-test-program", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--browser",
          "chromium"
        ],
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["bunx", "--bun", "chrome-devtools-mcp@latest", "--isolated"]
      }
    }
  }
}